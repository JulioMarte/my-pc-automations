# --- Exit (cada máquina que aporta salida) ---
EXIT_NAME=home
EXIT_HOST=100.110.109.28
EXIT_PORT=8899
EXIT_USER=exituser
EXIT_PASS=exitpass
# EXIT_USERS: varias credenciales validas a la vez, formato usuario:clave,usuario2:clave2.
# Permite rotar sin downtime (se agrega la nueva conservando la vieja, se verifica y recien
# despues se quita la vieja). EXIT_USER/EXIT_PASS siguen funcionando como fallback de una
# sola credencial. Si EXIT_USERS tiene valor, se suman ambas fuentes.
EXIT_USERS=
EXIT_ALLOW=100.110.109.28
EXIT_CONNECT_TIMEOUT_MS=15000
# EXIT_BLOCK_PRIVATE: bloquea SSRF a loopback/privadas/link-local/CGNAT/metadata y al puerto 25
# (true por defecto). Ponlo en false SOLO para pruebas locales.
EXIT_BLOCK_PRIVATE=true
# EXIT_IDLE_TIMEOUT_MS: cierra túneles CONNECT inactivos (0 = desactivado).
EXIT_IDLE_TIMEOUT_MS=0

# --- Gateway (máquina siempre encendida) ---
GATEWAY_HOST=100.110.109.28
GATEWAY_HTTP_PORT=8888
GATEWAY_SOCKS_PORT=1080
# PROXY_USERS: usuario:clave,usuario2:clave2 (un usuario por servicio; sin "-" en el nombre)
PROXY_USERS=agent:secret123,otro:otraClave456
SESSION_TTL_MS=600000
HEALTH_INTERVAL_MS=60000
# HEALTH_TARGETS: destinos de health check separados por comas (con jitter e histéresis).
# Si se define, tiene prioridad sobre HEALTH_TARGET.
HEALTH_TARGETS=api.ipify.org:443,www.google.com:443
# HEALTH_TARGET: fallback de un solo destino si HEALTH_TARGETS está vacío.
HEALTH_TARGET=api.ipify.org:443
HEALTH_TIMEOUT_MS=10000
CONNECT_TIMEOUT_MS=20000
# MAX_CONNECTIONS: límite de conexiones simultáneas del gateway (0 = sin límite).
MAX_CONNECTIONS=0
# MAX_CONNECTIONS_PER_USER: límite de conexiones simultáneas por usuario base/tenant
# (0 = ilimitado). Aplica al usuario base, así que "agent-session-x" y "agent-exit-home"
# comparten la cuota de "agent". Al superarlo: HTTP 429 con Retry-After y SOCKS5 rechazado.
MAX_CONNECTIONS_PER_USER=0
# STATS_TOKEN: OBLIGATORIO para leer /__stats. Si queda vacío, /__stats responde 403
# (estadísticas deshabilitadas).
STATS_TOKEN=
STATS_FILE=stats.jsonl
EXITS_FILE=exits.json

# --- Logs y métricas (gateway y exit) ---
# LOG_LEVEL: nivel mínimo de log (debug|info|warn|error). Por defecto info.
LOG_LEVEL=info
# LOG_FORMAT: json (una línea JSON por evento) o text (legible para desarrollo).
LOG_FORMAT=json
# METRICS_TOKEN: protege GET /metrics en el gateway y en el exit. Si queda vacío,
# /metrics queda abierto en el bind de Tailscale. Si se define, exige ?token=<valor>
# o Authorization: Bearer <valor>.
METRICS_TOKEN=
